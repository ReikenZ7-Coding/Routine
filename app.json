{
  "expo": {
    "name": "Routine",
    "slug": "routine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2F3F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.reikenz7.routine"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-font",
      "expo-splash-screen",
      [
        "expo-calendar",
        {
          "calendarPermission": "Routine shows your calendar events next to your routines so you can plan your day."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#141716"
        }
      ]
    ],
    "scheme": "routine"
  }
}
